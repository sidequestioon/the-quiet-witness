  goals:
  - id: who_sent
    main: 1
    mini: 0
    side: 0
    text: Find out who sent the envelope, and why.
    showWhen: prologue:envelope_opened
    doneWhen: 
  - id: riviera
    main: 0
    mini: 0
    side: 0
    text: Be at the Riviera for the last show.
    showWhen: prologue:envelope_opened
    doneWhen: riviera:seat
  - id: riviera_go
    main: 0
    mini: 1
    side: 0
    text: Get downtown to the Riviera.
    showWhen: prologue:envelope_opened
    doneWhen: visited:riviera
  - id: riviera_seat
    main: 0
    mini: 1
    side: 0
    text: Find row seven, seat twelve.
    showWhen: prologue:envelope_opened
    doneWhen: riviera:seat
  - id: film
    main: 0
    mini: 0
    side: 0
    text: Take a closer look at the film from the envelope.
    showWhen: prologue:envelope_opened
    doneWhen: darkroom:film_enlarged
  - id: film_find
    main: 0
    mini: 1
    side: 0
    text: Find something to make the frames bigger.
    showWhen: prologue:envelope_opened
    doneWhen: darkroom:enlarger_found
  - id: film_enlarge
    main: 0
    mini: 1
    side: 0
    text: Enlarge the frames with the enlarger.
    showWhen: darkroom:enlarger_found
    doneWhen: darkroom:film_enlarged
  - id: drawer
    main: 0
    mini: 0
    side: 0
    text: Open the locked drawer.
    showWhen: office:drawer_tried
    doneWhen: office:drawer_opened
  - id: drawer_code
    main: 0
    mini: 1
    side: 0
    text: Find the four numbers. I wrote them down somewhere.
    showWhen: office:drawer_tried
    doneWhen: darkroom:photo_seen
  - id: sal_favor
    main: 0
    mini: 0
    side: 1
    text: Do Sal a favor. Meet him at the Blue Note, tomorrow after nine.
    showWhen: office:sal_heard
    doneWhen: sal:met
