--- !u!114 &945583965
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 945583957}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5fb3417dab3384770809f12479d682f8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuietWitness.World.AnsweringMachine
  message:
  - speaker: ANSWERING MACHINE
    text: You have... one... new message.
  - speaker: SAL
    text: Hey, it's Sal. Yeah, I know. Long time.
  - speaker: SAL
    text: Listen, I need a favor. Nothing big. Probably.
  - speaker: SAL
    text: My sister's kid, Danny, got himself into something down at the Docks.
  - speaker: SAL
    text: I can't go asking around. Not with the badge on. You know how it is.
  - speaker: SAL
    text: Meet me at the Blue Note. Tomorrow, after nine. First round's on me.
  - speaker: ANSWERING MACHINE
    text: End of messages.
  heardFlag: office:sal_heard
  afterFirstTime: office.machine_after
  led: {fileID: 833707965}
  ledOn: {fileID: 21300000, guid: 90ff7643343844b9db6189a70605dbb0, type: 3}
  ledOff: {fileID: 21300000, guid: 4e9bce8b0d6c0454baad64a0d27453bb, type: 3}
  blinkTime: 0.6
  beep: {fileID: 8300000, guid: f739c9254fe784d80996644f1720677b, type: 3}
  beepVolume: 0.5
