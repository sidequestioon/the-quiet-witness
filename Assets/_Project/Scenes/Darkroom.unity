  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuietWitness.World.HotspotSteps
  steps:
  - note: the film from the envelope
    needs:
    - clue:envelope_filmclip
    unless:
    - darkroom:film_enlarged
    line: darkroom.enlarger_film
    setFlag: darkroom:enlarger_found
    then:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 710538028}
          m_TargetAssemblyTypeName: QuietWitness.Cutscenes.CloseUpOpener, Assembly-CSharp
          m_MethodName: OpenEnlarger
          m_Mode: 0
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: 
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - note: already done
    needs:
    - darkroom:film_enlarged
    unless: []
    line: darkroom.enlarger_done
    setFlag: 
    then:
      m_PersistentCalls:
        m_Calls: []
  - note: before the envelope
    needs: []
    unless: []
    line: darkroom.look_enlarger
    setFlag: 
    then:
      m_PersistentCalls:
        m_Calls: []
